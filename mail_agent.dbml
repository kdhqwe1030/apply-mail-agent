Project mail_reply_agent {
  database_type: 'PostgreSQL'
  Note: '모집 문의 메일 1차 답장 에이전트 — pgvector FAQ 검색 + 3단 판정'
}

Table faq {
  id serial [pk, note: 'FAQ 고유 번호']
  category varchar(40) [not null, note: '문의 유형. 이관 시 담당자 결정 기준']
  question text [not null, note: '질문 문장. 이 값을 임베딩해 검색 키로 쓴다']
  answer text [not null, note: '승인된 답변 원문. 모델이 지어내지 못하게 잡아두는 근거']
  source_url text [note: '출처 링크. 답장 하단에 인용']
  embedding "vector(1536)" [note: 'question의 임베딩 벡터']

  Note: '''
  지식 베이스. 여기 없는 질문은 답하지 않고 담당자에게 넘긴다.
  같은 답변이라도 질문 표현이 다르면 행을 따로 넣어 검색 적중률을 올린다.
  '''
}

Table email_log {
  id serial [pk, note: '처리 기록 번호']
  message_id varchar(255) [not null, unique, note: 'Message-ID. UNIQUE가 중복 답장 사고를 막는다']
  from_address varchar(255) [not null, note: '발송에만 사용. LLM 컨텍스트 제외']
  subject text [note: '메일 제목. 로그 조회용']
  body_text text [note: '원문 보관용. 검색 쿼리로는 쓰지 않는다']
  decision varchar(20) [note: 'auto_reply / draft_review / escalate']
  reply_body text [note: '생성된 답장 본문. escalate면 NULL']
  created_at timestamptz [not null, default: `now()`, note: '처리 시각']

  Note: '처리한 메일 1통 = 1행'
}

Table email_question {
  id serial [pk, note: '질문 고유 번호']
  log_id int [not null, note: '어느 메일에서 나온 질문인지']
  seq smallint [not null, note: '메일 안에서의 질문 순서']
  question_text text [not null, note: '인사말·서명을 걷어낸 질문 문장. 실제 검색 쿼리']
  matched_faq_id int [note: '검색으로 찾은 FAQ. 임계값 미달이면 NULL']
  distance real [note: '코사인 거리. 판정 근거이자 임계값 비교 대상']

  indexes {
    (log_id, seq) [unique]
  }

  Note: '''
  메일에서 뽑아낸 질문 1개 = 1행.
  한 통에 질문이 여러 개 오는 경우가 흔해 행으로 나눈다.
  '1번은 FAQ에 있고 2번은 없다' 같은 부분 판정의 근거가 여기 남는다.
  '''
}

Ref: email_question.log_id > email_log.id [delete: cascade]
Ref: email_question.matched_faq_id > faq.id
